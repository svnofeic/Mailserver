{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "Mailserver": {
    "Hostname": "mail.example.com",
    "DataDirectory": "data",
    "MaxMessageSizeBytes": 52428800,
    "Tls": {
      "PfxPath": null,
      "PfxPassword": null,
      "StoreSubject": null,
      "ReloadInterval": "01:00:00",
      "Acme": {
        "Enabled": false,
        "Email": null,
        "Hostnames": null,
        "UseStaging": false,
        "ChallengeDirectory": null
      }
    },
    "Smtp": {
      "ListenAddresses": [ "0.0.0.0" ],
      "InboundPort": 25,
      "SubmissionPort": 587,
      "SubmissionTlsPort": 465,
      "AllowInsecureAuthentication": false,
      "RelayNetworks": [],
      "SaveSentCopies": true
    },
    "Imap": {
      "ListenAddresses": [ "0.0.0.0" ],
      "Port": 143,
      "TlsPort": 993,
      "AllowInsecureAuthentication": false,
      "MaxConnectionsPerIp": 30,
      "IdleTimeout": "00:31:00",
      "Trace": false
    },
    "Web": {
      "Enabled": true,
      "ListenAddresses": [ "0.0.0.0" ],
      "HttpsPort": 9443,
      "InsecureHttpPort": 0,
      "SessionTimeout": "01:00:00"
    },
    "Delivery": {
      "PollInterval": "00:00:15",
      "MaxParallelDeliveries": 4,
      "MaxQueueLifetime": "5.00:00:00",
      "SmartHost": null
    },
    "Spam": {
      "Enabled": true,
      "TrustLoopback": true,
      "TrustedNetworks": [],
      "JunkThreshold": 5.0,
      "DeleteThreshold": 0,
      "EnforceDmarcReject": true,
      "RejectSpfFail": false,
      "DnsBlocklistsEnabled": true,
      "DnsBlocklists": [],
      "Greylisting": {
        "Enabled": true,
        "Delay": "00:05:00",
        "Expiry": "36.00:00:00",
        "SkipOnSpfPass": true
      },
      "Log": {
        "Enabled": true,
        "RetentionDays": 90,
        "IncludeSubject": true
      }
    },
    "Security": {
      "MaxAuthFailuresPerIp": 10,
      "AuthFailureWindow": "00:15:00",
      "AuthLockoutDuration": "00:30:00",
      "RejectUnauthenticatedLocalSender": true,
      "MaxHopCount": 30,
      "Sending": {
        "MaxRecipientsPerMessage": 100,
        "MaxRecipientsPerHour": 300,
        "MaxRecipientsPerDay": 1000,
        "BlockOnLimit": true
      }
    },
    "Antivirus": {
      "Enabled": true,
      "Scanner": "Auto",
      "ClamAvHost": "127.0.0.1",
      "ClamAvPort": 3310,
      "ScanOutgoing": true,
      "BlockedExtensions": null,
      "SuspiciousAttachments": "Junk",
      "OnScanError": "Accept"
    }
  }
}
