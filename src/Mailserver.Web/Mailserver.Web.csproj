<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\editor.js" LogicalName="editor.js" />
    <EmbeddedResource Include="Assets\site.css" LogicalName="site.css" />
    <EmbeddedResource Include="Assets\app.js" LogicalName="app.js" />
    <EmbeddedResource Include="Assets\sw.js" LogicalName="sw.js" />
    <EmbeddedResource Include="Assets\offline.html" LogicalName="offline.html" />
    <EmbeddedResource Include="Assets\icons\*.png" LogicalName="icons/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailserver.Core\Mailserver.Core.csproj" />
    <ProjectReference Include="..\Mailserver.AntiSpam\Mailserver.AntiSpam.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
  </ItemGroup>

</Project>
