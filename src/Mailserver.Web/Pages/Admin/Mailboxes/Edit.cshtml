@page
@model Mailserver.Web.Pages.Admin.Mailboxes.EditModel
@{ ViewData["Title"] = Model.Account.Address.ToString(); }
<div class="page-head">
    <h1>Postfach @Model.Account.Address</h1>
    @if (!Model.IsSelf && Model.Account.Enabled)
    {
        <form method="post" asp-page-handler="Impersonate" asp-route-address="@Model.Account.Address" class="actions">
            <button type="submit" class="secondary" title="Webmail dieses Postfachs öffnen, wie der Benutzer es sieht – wird im Verlauf protokolliert">@Icons.Get("eye") Als Benutzer anmelden</button>
        </form>
    }
</div>

<div class="tiles">
    <div class="tile"><div class="label">Belegt</div><div class="value">@Format.Size(Model.Usage)</div></div>
    <div class="tile"><div class="label">Nachrichten</div><div class="value">@Model.Folders.Sum(f => f.Status.Messages)</div></div>
    <div class="tile"><div class="label">Regeln</div><div class="value">@Model.RuleCount</div></div>
</div>

<h2>Einstellungen</h2>
<form method="post" asp-page-handler="Save" asp-route-address="@Model.Account.Address" class="card">
    <div class="row">
        <label>Speicherlimit in MB (0 = ohne)<input name="quotaMb" type="number" min="0" value="@(Model.Account.QuotaBytes / 1024 / 1024)" style="width: 120px" /></label>
        <label class="check"><input type="checkbox" name="enabled" value="true" checked="@Model.Account.Enabled" disabled="@Model.IsSelf" /> aktiv</label>
        <label class="check"><input type="checkbox" name="isAdmin" value="true" checked="@Model.Account.IsAdmin" disabled="@Model.IsSelf" /> Admin</label>
        @if (Model.IsSelf)
        {
            <input type="hidden" name="enabled" value="true" /><input type="hidden" name="isAdmin" value="true" />
        }
        <button type="submit">Speichern</button>
    </div>
    @if (Model.IsSelf) { <p class="small muted">Das eigene Postfach kann man sich nicht selbst deaktivieren oder die Admin-Rechte entziehen.</p> }
</form>

<form method="post" asp-page-handler="Automation" asp-route-address="@Model.Account.Address" style="max-width: 760px">
    <partial name="_MailboxAutomation" model="Model.Form" />
    <button type="submit">Weiterleitung und Abwesenheit speichern</button>
</form>

<h2>Versand</h2>
<div class="card">
    @if (Model.Sending.BlockedSince is { } blocked)
    {
        <div class="notice bad">
            Versand gesperrt seit @Format.Time(blocked): @Model.Sending.BlockedReason. Vor dem Freigeben am besten das Passwort ändern und im
            <a href="/Admin/Log?search=@Model.Account.Address">Verlauf</a> prüfen, was verschickt wurde.
            <form method="post" asp-page-handler="Unblock" asp-route-address="@Model.Account.Address" class="inline">
                <button type="submit" class="secondary">Versand freigeben</button>
            </form>
        </div>
    }
    <p class="small" style="margin-top: 0">Externe Empfänger: @Model.SendingUsage.Hour in der letzten Stunde, @Model.SendingUsage.Day in den letzten 24 Stunden.</p>
    <form method="post" asp-page-handler="SendingLimits" asp-route-address="@Model.Account.Address" class="row">
        <label>Limit pro Stunde (leer = Standard @Model.DefaultLimits.MaxRecipientsPerHour)
            <input name="perHour" type="number" min="0" value="@Model.Sending.PerHour" style="width: 120px" /></label>
        <label>Limit pro Tag (leer = Standard @Model.DefaultLimits.MaxRecipientsPerDay)
            <input name="perDay" type="number" min="0" value="@Model.Sending.PerDay" style="width: 120px" /></label>
        <button type="submit" class="secondary">Limits speichern</button>
        <span class="small muted">0 = ohne Limit, z. B. für ein Newsletter-Postfach.</span>
    </form>
</div>

<h2>Ersatz-Adresse für „Passwort vergessen“</h2>
<div class="card">
    @if (Model.Account.IsAdmin)
    {
        <p class="small muted" style="margin: 0">Administratoren können ihr Passwort nicht per E-Mail zurücksetzen (auf dem Server:
            <span class="mono">mailadmin user passwd @Model.Account.Address</span>).</p>
    }
    else
    {
        <p class="small muted" style="margin-top: 0">An diese externe Adresse geht der Link, wenn der Benutzer „Passwort vergessen“ wählt.
            Hier eingetragen gilt sie sofort als bestätigt; der Benutzer kann sie auch selbst unter „Passwort“ eintragen.</p>
        <form method="post" asp-page-handler="Recovery" asp-route-address="@Model.Account.Address" class="row">
            <label>Ersatz-Adresse<input name="recoveryAddress" type="email" value="@Model.Recovery?.Address" placeholder="name@gmx.de" style="width: 280px" /></label>
            @if (Model.Recovery is { } current)
            {
                @if (current.Verified) { <span class="pill good">bestätigt</span> } else { <span class="pill warn">wartet auf Bestätigung</span> }
            }
            <button type="submit" class="secondary">Speichern</button>
            @if (Model.Recovery is not null)
            {
                <button type="submit" name="remove" value="true" class="secondary">Entfernen</button>
            }
        </form>
    }
</div>

<h2>Passwort setzen</h2>
<form method="post" asp-page-handler="Password" asp-route-address="@Model.Account.Address" class="row card">
    <label>Neues Passwort (mind. @PasswordRules.MinLength Zeichen)<input name="password" type="password" autocomplete="new-password" required /></label>
    <button type="submit">Passwort setzen</button>
    <span class="small muted">Alle angemeldeten Sitzungen des Postfachs werden beendet.</span>
</form>

<h2>Ordner</h2>
<div class="table-wrap">
    <table>
        <thead><tr><th>Ordner</th><th class="num">Nachrichten</th><th class="num">Ungelesen</th></tr></thead>
        <tbody>
        @foreach (var (folder, status) in Model.Folders)
        {
            <tr><td>@Format.FolderName(folder.Name)</td><td class="num">@status.Messages</td><td class="num">@status.Unseen</td></tr>
        }
        </tbody>
    </table>
</div>
<p><a href="/Admin/Rules?scope=@Model.Account.Address">Regeln des Postfachs</a> · <a href="/Admin/Log?search=@Model.Account.Address">Verlauf des Postfachs</a></p>

@if (!Model.IsSelf)
{
    <h2>Postfach löschen</h2>
    <div class="card">
        <details class="confirm"><summary>Postfach löschen …</summary>
            <form method="post" asp-page-handler="Delete" asp-route-address="@Model.Account.Address" class="inline">
                <button type="submit" class="danger">@Model.Account.Address mit allen Nachrichten löschen</button>
            </form>
        </details>
    </div>
}
