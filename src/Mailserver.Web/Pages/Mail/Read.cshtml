@page
@model Mailserver.Web.Pages.Mail.ReadModel
@{ ViewData["Title"] = Model.Subject; var f = Uri.EscapeDataString(Model.Folder.Name); var uid = Model.Stored.Uid; }
<div class="mail">
    <aside>
        <a class="button" href="/Mail/Compose">@Icons.Get("pencil") Neue Mail</a>
        <partial name="_Folders" model="(Model.Folders, Model.Folder.Name)" />
    </aside>
    <section>
        <div class="toolbar small icon-toolbar">
            <a class="button secondary icon-button" href="/Mail?folder=@f" title="Zurück zu „@Format.FolderName(Model.Folder.Name)“" aria-label="Zurück zu @Format.FolderName(Model.Folder.Name)">←</a>
            <span class="toolbar-sep" aria-hidden="true"></span>
            @if (Model.Folder.Name is "Drafts" or Mailserver.Core.Storage.FollowUps.ScheduledFolder)
            {
                <a class="button" href="/Mail/Compose?mode=draft&folder=@f&uid=@uid">@Icons.Get("pencil") @(Model.Folder.Name == "Drafts" ? "Entwurf bearbeiten" : "Geplante Mail bearbeiten")</a>
            }
            else
            {
                <a class="button secondary icon-button" href="/Mail/Compose?mode=reply&folder=@f&uid=@uid" title="Antworten" aria-label="Antworten">@Icons.Get("reply")</a>
                <a class="button secondary icon-button" href="/Mail/Compose?mode=replyall&folder=@f&uid=@uid" title="Allen antworten" aria-label="Allen antworten">@Icons.Get("reply-all")</a>
                <a class="button secondary icon-button" href="/Mail/Compose?mode=forward&folder=@f&uid=@uid" title="Weiterleiten" aria-label="Weiterleiten">@Icons.Get("forward")</a>
            }
            <span class="toolbar-sep" aria-hidden="true"></span>
            @{
                var deleteLabel = Model.Folder.Name == "Trash" ? "Endgültig löschen" : "Löschen";
                var flagged = Model.Stored.HasFlag("\\Flagged");
                var flagLabel = flagged ? "Markierung entfernen" : "Markieren";
            }
            <form method="post" asp-page="/Mail/Read" asp-page-handler="Action" asp-route-folder="@Model.Folder.Name" asp-route-uid="@uid" class="row">
                <button type="submit" name="op" value="delete" class="secondary icon-button" title="@deleteLabel" aria-label="@deleteLabel">@Icons.Get("trash")</button>
                @if (Model.Folder.Name == "Junk") { <button type="submit" name="op" value="notspam" class="secondary icon-button" title="Kein Spam" aria-label="Kein Spam">@Icons.Get("shield")</button> }
                else { <button type="submit" name="op" value="spam" class="secondary icon-button" title="Spam" aria-label="Spam">@Icons.Get("shield-alert")</button> }
                <button type="submit" name="op" value="unread" class="secondary icon-button" title="Als ungelesen markieren" aria-label="Ungelesen">@Icons.Get("mail-unread")</button>
                <button type="submit" name="op" value="@(flagged ? "unflag" : "flag")" class="secondary icon-button@(flagged ? " active" : "")" title="@flagLabel" aria-label="@flagLabel">@Icons.Get("star")</button>
            </form>
            @if (Model.Folder.Name is not ("Drafts" or "Sent" or "Trash" or "Junk" or Mailserver.Core.Storage.FollowUps.ScheduledFolder))
            {
                <details class="send-later">
                    <summary class="button secondary icon-button" title="Wiedervorlage" aria-label="Wiedervorlage">@Icons.Get("clock")</summary>
                    <form method="post" asp-page="/Mail/Read" asp-page-handler="FollowUp" asp-route-folder="@Model.Folder.Name" asp-route-uid="@uid" class="send-later-panel">
                        <strong>Wiedervorlage</strong>
                        <label>Wieder anzeigen
                            <select name="choice">
                                @foreach (var (key, label) in Model.FollowUpChoices) { <option value="@key" selected="@(key == "tomorrow8")">@label</option> }
                            </select></label>
                        <label>Oder Datum und Uhrzeit<input type="datetime-local" name="at" /></label>
                        <button type="submit">Wiedervorlage setzen</button>
                        <span class="small muted">Die Mail verschwindet bis dahin in den Ordner „Wiedervorlage“ und kommt dann ungelesen zurück.</span>
                    </form>
                </details>
            }
            <span class="toolbar-sep" aria-hidden="true"></span>
            <form method="post" asp-page="/Mail/Read" asp-page-handler="Action" asp-route-folder="@Model.Folder.Name" asp-route-uid="@uid" class="row move-form">
                <select name="target" aria-label="Zielordner">
                    @foreach (var (folder, _) in Model.Folders.Where(x => x.Folder.Name != Model.Folder.Name)) { <option value="@folder.Name">@Mailserver.Web.Webmail.FolderDisplay.Path(folder.Name)</option> }
                </select>
                <button type="submit" name="op" value="move" class="secondary icon-button" title="In den gewählten Ordner verschieben" aria-label="Verschieben">@Icons.Get("folder")</button>
            </form>
        </div>

        <div class="card">
            <h1 style="margin-top: 0">@Model.Subject</h1>
            <dl class="headers">
                <dt>Von</dt><dd>@Model.Mail.From</dd>
                <dt>An</dt><dd>@Model.Mail.To</dd>
                @if (Model.Mail.Cc.Count > 0) { <dt>Cc</dt><dd>@Model.Mail.Cc</dd> }
                @if (Model.Mail.Bcc.Count > 0) { <dt>Bcc</dt><dd>@Model.Mail.Bcc</dd> }
                <dt>Datum</dt><dd>@Format.Time(Model.Mail.Date == default ? Model.Stored.InternalDate : Model.Mail.Date)</dd>
                @if (Model.SpamScore is not null) { <dt>Spam-Score</dt><dd>@Model.SpamScore</dd> }
            </dl>
        </div>

        @if (Model.HasRemoteContent && !Model.ShowImages)
        {
            <div class="notice warn small">Externe Bilder wurden zum Schutz Ihrer Privatsphäre blockiert (sie verraten dem Absender, dass die Mail gelesen wurde).
                <a href="/Mail/Read?folder=@f&uid=@uid&images=1">Bilder anzeigen</a></div>
        }
        <iframe class="mailbody" title="Nachricht" src="/Mail/Body?folder=@f&uid=@uid&images=@(Model.ShowImages ? 1 : 0)"
                sandbox="allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"></iframe>

        @if (Model.Attachments.Count > 0)
        {
            <h2>Anhänge</h2>
            <div class="table-wrap"><table><tbody>
                @for (var i = 0; i < Model.Attachments.Count; i++)
                {
                    var link = $"/Mail/Attachment?folder={f}&uid={uid}&index={i}";
                    <tr>
                        @if (Model.Attachments[i].Viewable)
                        {
                            <td>📎 <a href="@(link)&amp;view=1" target="_blank" rel="noopener" title="Im Browser anzeigen">@Model.Attachments[i].Name</a></td>
                        }
                        else
                        {
                            <td>📎 <a href="@link">@Model.Attachments[i].Name</a></td>
                        }
                        <td class="small muted">@Model.Attachments[i].Type</td>
                        <td class="num small muted">@Format.Size(Model.Attachments[i].Size)</td>
                        <td class="num small">
                            @if (Model.Attachments[i].Viewable) { <a href="@(link)&amp;view=1" target="_blank" rel="noopener">Anzeigen</a><text> · </text> }
                            <a href="@link">Herunterladen</a>
                        </td>
                    </tr>
                }
            </tbody></table></div>
        }
        <p class="small"><a href="/Mail/Attachment?folder=@f&uid=@uid&source=1">Quelltext herunterladen (.eml)</a></p>
    </section>
</div>
