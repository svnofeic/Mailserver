@page
@model Mailserver.Web.Pages.Mail.IndexModel
@{ ViewData["Title"] = Mailserver.Web.Webmail.FolderDisplay.Leaf(Model.Folder.Name); }
<div class="mail">
    <aside>
        <a class="button" href="/Mail/Compose">@Icons.Get("pencil") Neue Mail</a>
        <partial name="_Folders" model="(Model.Folders, Model.Folder.Name)" />
    </aside>
    <section>
        <div class="toolbar">
            <h1 style="margin: 0" class="grow">@Mailserver.Web.Webmail.FolderDisplay.Path(Model.Folder.Name)</h1>
            <form method="get" action="/Mail" class="search">
                <input type="hidden" name="folder" value="@Model.Folder.Name" />
                @Icons.Get("search")
                <input name="q" value="@Model.Search" placeholder="Absender, Empfänger, Betreff suchen" aria-label="Suche" />
                <button type="submit" class="secondary">Suchen</button>
            </form>
        </div>

        <form method="post" asp-page-handler="Bulk">
            <input type="hidden" name="folder" value="@Model.Folder.Name" />
            <input type="hidden" name="page" value="@Model.PageNumber" />
            <div class="toolbar small">
                @if (Model.Items.Count > 0)
                {
                    <label class="check select-all" title="Alle Nachrichten auf dieser Seite auswählen"><input type="checkbox" data-select-all /> Alle</label>
                }
                <button type="submit" name="op" value="read" class="secondary">Gelesen</button>
                <button type="submit" name="op" value="unread" class="secondary">Ungelesen</button>
                <button type="submit" name="op" value="flag" class="secondary">Markieren</button>
                @if (Model.Folder.Name == "Junk")
                {
                    <button type="submit" name="op" value="notspam" class="secondary">Kein Spam</button>
                }
                else
                {
                    <button type="submit" name="op" value="spam" class="secondary">Spam</button>
                }
                <button type="submit" name="op" value="delete" class="secondary">@Icons.Get("trash") @(Model.Folder.Name == "Trash" ? "Endgültig löschen" : "Löschen")</button>
                <select name="target" aria-label="Zielordner">
                    @foreach (var (folder, _) in Model.Folders.Where(f => f.Folder.Name != Model.Folder.Name)) { <option value="@folder.Name">@Mailserver.Web.Webmail.FolderDisplay.Path(folder.Name)</option> }
                </select>
                <button type="submit" name="op" value="move" class="secondary">Verschieben</button>
                @if (Mailserver.Web.Webmail.MailActions.CanEmpty(Model.Folder) && Model.Total > 0 && Model.Search is null)
                {
                    var name = Model.Folder.Name == "Trash" ? "Papierkorb" : "Spam-Ordner";
                    <button type="submit" asp-page-handler="Empty" class="danger"
                            data-confirm="@($"{name} leeren? Alle {Model.Total} Nachrichten werden endgültig gelöscht.")">@Icons.Get("trash") @name leeren</button>
                }
                <span class="grow"></span>
                <span class="muted">@Model.Total Nachricht(en)</span>
            </div>

            @if (Model.Items.Count == 0)
            {
                <div class="card muted">@(Model.Search is null ? "Dieser Ordner ist leer." : "Keine Nachricht gefunden.")</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="messages">
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="@(item.Seen ? "" : "unread")">
                                <td class="sel"><input type="checkbox" name="uids" value="@item.Message.Uid" aria-label="Auswählen" /></td>
                                @{ var person = Model.ShowRecipients ? item.Summary.To : item.Summary.From; }
                                <td class="from"><span class="sender"><span class="avatar @Avatars.Class(person)">@Avatars.Initials(person)</span><span>@person</span></span></td>
                                <td class="subject">
                                    <a href="/Mail/Read?folder=@Uri.EscapeDataString(Model.Folder.Name)&uid=@item.Message.Uid">
                                        @if (item.Flagged) { <span class="mark" title="markiert">@Icons.Get("star", "star")</span> }
                                        @if (item.Answered) { <span title="beantwortet">@Icons.Get("reply")</span> }
                                        <span class="text">@item.Summary.Subject</span>
                                        @if (item.Summary.HasAttachments) { <span title="Anhang">@Icons.Get("paperclip")</span> }
                                    </a>
                                </td>
                                <td class="date small muted">@Format.Time(item.Message.InternalDate)</td>
                                <td class="size num small muted">@Format.Size(item.Message.Size)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </form>

        @if (Model.PageCount > 1)
        {
            <div class="toolbar">
                @if (Model.PageNumber > 0) { <a class="button secondary" href="@Model.PageUrl(Model.PageNumber - 1)">← Neuere</a> }
                <span class="muted">Seite @(Model.PageNumber + 1) von @Model.PageCount</span>
                @if (Model.PageNumber + 1 < Model.PageCount) { <a class="button secondary" href="@Model.PageUrl(Model.PageNumber + 1)">Ältere →</a> }
            </div>
        }
        @if (Model.Folder.Name == "Junk")
        {
            <p class="small muted">Mails, die fälschlich hier gelandet sind, mit „Kein Spam“ in den Posteingang holen – das hilft beim Verbessern des Spamfilters.</p>
        }
    </section>
</div>
