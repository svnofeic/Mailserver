@page
@model Mailserver.Web.Pages.Account.PasswordModel
@{ ViewData["Title"] = "Passwort ändern"; }
<h1>Passwort ändern</h1>
<div class="card" style="max-width: 460px">
    <p class="small muted">Das Passwort gilt für das Mailprogramm (IMAP/SMTP) und diese Weboberfläche. Nach der Änderung muss es auf allen
        Geräten neu eingegeben werden.</p>
    <form method="post">
        <div class="row" style="flex-direction: column; align-items: stretch">
            <label>Aktuelles Passwort<input name="current" type="password" autocomplete="current-password" required /></label>
            <label>Neues Passwort (mindestens 10 Zeichen)<input name="password" type="password" autocomplete="new-password" minlength="10" required /></label>
            <label>Neues Passwort wiederholen<input name="confirm" type="password" autocomplete="new-password" minlength="10" required /></label>
            <div><button type="submit">Passwort ändern</button></div>
        </div>
    </form>
</div>

<h2>Passwort vergessen?</h2>
<div class="card" style="max-width: 560px">
    @if (Model.IsAdmin)
    {
        <p class="small muted" style="margin: 0">Für Administratoren gibt es kein Zurücksetzen per E-Mail – wer deren Ersatz-Adresse übernimmt,
            hätte sonst den ganzen Server. Ein vergessenes Admin-Passwort wird auf dem Server gesetzt:
            <span class="mono">mailadmin user passwd @Model.CurrentAddress</span></p>
    }
    else
    {
        <p class="small muted" style="margin-top: 0">Mit einer <strong>Ersatz-Adresse</strong> (z. B. bei GMX, Gmail oder Outlook) können Sie ein vergessenes
            Passwort auf der Anmeldeseite selbst zurücksetzen: Der Link dazu geht an diese Adresse.</p>
        @if (Model.Recovery is { } current)
        {
            <p>Ersatz-Adresse: <strong>@current.Address</strong>
                @if (current.Verified) { <span class="pill good">bestätigt</span> } else { <span class="pill warn">wartet auf Bestätigung</span> }</p>
        }
        <form method="post" asp-page-handler="Recovery">
            <div class="row" style="flex-direction: column; align-items: stretch">
                <label>@(Model.Recovery is null ? "Ersatz-Adresse" : "Neue Ersatz-Adresse")<input name="address" type="email" required placeholder="name@gmx.de" /></label>
                <label>Aktuelles Passwort<input name="current" type="password" autocomplete="current-password" required /></label>
                <div class="row">
                    <button type="submit">Speichern und Bestätigungslink senden</button>
                    @if (Model.Recovery is not null)
                    {
                        <button type="submit" asp-page-handler="RemoveRecovery" class="secondary" formnovalidate>Ersatz-Adresse entfernen</button>
                    }
                </div>
            </div>
        </form>
    }
</div>
