@using Mailserver.Core.SpamLogging
@model IReadOnlyList<(SpamLogEntry Delivery, SpamLogEntry? Message)>
@{
    var showRecipient = ViewData["ShowRecipient"] is true;
    var allowActions = ViewData["AllowActions"] is true;
}
@if (Model.Count == 0)
{
    <div class="card muted">Keine Einträge im gewählten Zeitraum.</div>
}
else
{
    <div class="table-wrap">
        <table class="delivery">
            <thead>
            <tr>
                <th class="time">Zeit</th>
                @if (showRecipient) { <th class="recipient">Empfänger</th> }
                <th class="sender">Absender</th><th class="subject">Betreff</th><th class="num score">Score</th><th class="result">Ergebnis</th><th class="reason">Grund</th>
                @if (allowActions) { <th class="actions"></th> }
            </tr>
            </thead>
            <tbody>
            @foreach (var (delivery, message) in Model)
            {
                var discarded = delivery.Action == SpamLogAction.Discarded;
                var junk = delivery.Folder == "Junk";
                <tr>
                    <td class="small time"><span>@delivery.Time.ToLocalTime().ToString("dd.MM.yyyy")</span> <span>@delivery.Time.ToLocalTime().ToString("HH:mm")</span></td>
                    @if (showRecipient) { <td class="small">@delivery.Recipient</td> }
                    <td class="small" title="@message?.HeaderFrom">@message?.HeaderFrom<div class="muted">@(message?.MailFrom != message?.HeaderFrom ? message?.MailFrom : null)</div></td>
                    <td>@message?.Subject</td>
                    <td class="num">@Format.Score(delivery.Score)</td>
                    <td>
                        @if (discarded) { <span class="pill bad">gelöscht</span> }
                        else if (junk) { <span class="pill bad">Spam</span> }
                        else { <span class="pill good">@Format.FolderName(delivery.Folder)</span> }
                    </td>
                    <td class="small">
                        @if (delivery.Rules is not null) { <div>Regel: @delivery.Rules</div> }
                        @if (delivery.Detail is not null) { <div class="muted">@delivery.Detail</div> }
                        @if (message?.Tests is { } tests) { <div class="muted mono">@tests.Replace(",", ", ")</div> }
                    </td>
                    @if (allowActions)
                    {
                        <td class="small">
                            @if (message?.HeaderFrom is { Length: > 0 } sender)
                            {
                                @if (junk || discarded)
                                {
                                    <form method="post" asp-page="/Spam/Index" asp-page-handler="Allow" class="inline">
                                        <input type="hidden" name="sender" value="@sender" />
                                        <button type="submit" class="secondary" title="Regel anlegen: Mails dieses Absenders nie als Spam behandeln">Absender erlauben</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page="/Spam/Index" asp-page-handler="Block" class="inline">
                                        <input type="hidden" name="sender" value="@sender" />
                                        <button type="submit" class="secondary" title="Regel anlegen: Mails dieses Absenders in den Spam-Ordner">Als Spam einstufen</button>
                                    </form>
                                }
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
