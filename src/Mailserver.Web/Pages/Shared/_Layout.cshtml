@inject Mailserver.Core.Accounts.MailboxSettingsStore MailboxSettings
@inject Mailserver.Core.Storage.MailboxStore Mailboxes
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.HasClaim(WebHosting.AdminClaim, "true");
    var path = Context.Request.Path.Value ?? "/";
    var theme = WebHosting.Theme(Context);
    var version = Uri.EscapeDataString(Mailserver.Core.BuildInfo.Version);
    long? currentAccountId = signedIn && long.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var parsedId) ? parsedId : null;
    // Unread mails in the inbox, shown on the icon of the installed app.
    var unread = currentAccountId is { } id && Mailboxes.GetFolder(id, "INBOX") is { } inbox ? Mailboxes.GetStatus(inbox.Id).Unseen : 0;
    string Active(string prefix, bool exact = false) =>
        (exact ? path.Equals(prefix, StringComparison.OrdinalIgnoreCase) : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="de" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="@(theme == "light" ? "#f3f5fc" : "#0b1030")" />
    <meta name="application-name" content="Mail" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Mail" />
    <meta name="apple-mobile-web-app-status-bar-style" content="@(theme == "light" ? "default" : "black-translucent")" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="@(theme == "light" ? "light" : "dark")" />
    <title>@ViewData["Title"] – Mailserver</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%238b6dff'/%3E%3Cstop offset='1' stop-color='%233b8bff'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='32' height='32' rx='9' fill='url(%23g)'/%3E%3Cpath d='M8 11l8 6 8-6M8 10h16v12H8z' stroke='white' stroke-width='2' fill='none' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link rel="stylesheet" href="/assets/site.css?v=@version" />
    <script src="/assets/app.js?v=@version" defer></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body data-unread="@unread">
<div class="shell@(signedIn ? " signed-in" : "")">
@if (signedIn)
{
<aside class="sidebar">
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menü öffnen" />
    <div class="sidebar-top">
        <a class="brand" href="/"><span class="logo">@Icons.Get("mail")</span><span>Mailserver<small>@Context.Request.Host.Host</small></span></a>
        <label for="nav-toggle" class="burger" title="Menü"></label>
    </div>
    <div class="menu">
        <nav aria-label="Hauptmenü">
            <a class="@Active("/", exact: true)" href="/">@Icons.Get("grid") Übersicht</a>
            <a class="@Active("/Mail")" href="/Mail">@Icons.Get("inbox") Mail</a>
            <a class="@Active("/Rules")" href="/Rules">@Icons.Get("filter") Regeln</a>
            <a class="@Active("/Spam")" href="/Spam">@Icons.Get("shield") Spam-Verlauf</a>
            <a class="@Active("/Account/Away")" href="/Account/Away">@Icons.Get("plane") Abwesenheit</a>
            <a class="@Active("/Account/Password")" href="/Account/Password">@Icons.Get("key") Passwort</a>
            @if (isAdmin)
            {
                <details open="@(path.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase))">
                    <summary>@Icons.Get("server") Verwaltung</summary>
                    <a class="@Active("/Admin", exact: true)" href="/Admin">@Icons.Get("activity") Server-Übersicht</a>
                    <a class="@Active("/Admin/Domains")" href="/Admin/Domains">@Icons.Get("globe") Domains</a>
                    <a class="@Active("/Admin/Mailboxes")" href="/Admin/Mailboxes">@Icons.Get("users") Postfächer</a>
                    <a class="@Active("/Admin/Aliases")" href="/Admin/Aliases">@Icons.Get("at") Aliase</a>
                    <a class="@Active("/Admin/Rules")" href="/Admin/Rules">@Icons.Get("list") Alle Regeln</a>
                    <a class="@Active("/Admin/Queue")" href="/Admin/Queue">@Icons.Get("clock") Warteschlange</a>
                    <a class="@Active("/Admin/Log")" href="/Admin/Log">@Icons.Get("eye") Verlauf</a>
                    <a class="@Active("/Admin/IpBlocks")" href="/Admin/IpBlocks">@Icons.Get("ban") IP-Sperren</a>
                    <a class="@Active("/Admin/Certificate")" href="/Admin/Certificate">@Icons.Get("lock") Zertifikat</a>
                    <a class="@Active("/Admin/Backup")" href="/Admin/Backup">@Icons.Get("cloud") Datensicherung</a>
                    <a class="@Active("/Admin/Diagnose")" href="/Admin/Diagnose">@Icons.Get("pulse") Diagnose</a>
                    <a class="@Active("/Admin/Settings")" href="/Admin/Settings">@Icons.Get("settings") Einstellungen</a>
                </details>
            }
        </nav>
        <div class="who">
            <div class="account">
                <span class="avatar @Avatars.Class(User.Identity!.Name ?? "")">@Avatars.Initials(User.Identity!.Name ?? "")</span>
                <span>@User.Identity!.Name</span>
            </div>
            <div class="actions">
                <a class="button" href="/theme?mode=@(theme == "light" ? "dark" : "light")&amp;returnUrl=@Uri.EscapeDataString(path + Context.Request.QueryString)"
                   title="@(theme == "light" ? "Dunkles Design" : "Helles Design")">@Icons.Get(theme == "light" ? "moon" : "sun") @(theme == "light" ? "Dunkel" : "Hell")</a>
                <form method="post" asp-page="/Logout"><button type="submit">@Icons.Get("logout") Abmelden</button></form>
            </div>
            <span class="version">Version @Mailserver.Core.BuildInfo.Version</span>
        </div>
    </div>
</aside>
}
<main>
    @if (TempData.Peek("Message") is string message)
    {
        <div class="notice good" role="status">@message</div>
        TempData.Remove("Message");
    }
    @if (TempData.Peek("ErrorMessage") is string error)
    {
        <div class="notice bad" role="alert">@error</div>
        TempData.Remove("ErrorMessage");
    }
    @if (signedIn && !path.StartsWith("/Account/Away", StringComparison.OrdinalIgnoreCase) &&
         long.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var accountId) &&
         MailboxAutomationForm.Describe(MailboxSettings.Get(accountId), DateOnly.FromDateTime(DateTime.Now)) is { } automation)
    {
        <div class="notice warn small">Für Ihr Postfach gilt: @automation. <a href="/Account/Away">Ändern</a></div>
    }
    @RenderBody()
</main>
</div>
</body>
</html>
