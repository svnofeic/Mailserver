@model MailboxAutomationForm
@* Fields of the forwarding / out-of-office form; the surrounding <form> and button belong to the page. *@
<h2>Weiterleitung</h2>
<div class="card">
    <p class="small muted" style="margin-top: 0">Eingehende Mails werden automatisch an diese Adressen weitergeleitet – Spam nicht.
        Eine Adresse pro Zeile, höchstens 10. Leer lassen schaltet die Weiterleitung aus.</p>
    <label class="stack">Weiterleiten an
        <textarea name="Form.ForwardTo" rows="3" placeholder="name@beispiel.de" autocomplete="off">@Model.ForwardTo</textarea>
    </label>
    <label class="check"><input type="checkbox" name="Form.KeepCopy" value="true" checked="@Model.KeepCopy" /> Kopie im Postfach behalten</label>
    <input type="hidden" name="Form.KeepCopy" value="false" />
</div>

<h2>Abwesenheitsnotiz</h2>
<div class="card">
    <label class="check"><input type="checkbox" name="Form.AutoReplyEnabled" value="true" checked="@Model.AutoReplyEnabled" /> Abwesenheitsnotiz einschalten</label>
    <div class="row" style="margin-top: 10px">
        <label>Von (optional)<input type="date" name="Form.From" value="@Model.From?.ToString("yyyy-MM-dd")" /></label>
        <label>Bis einschließlich (optional)<input type="date" name="Form.Until" value="@Model.Until?.ToString("yyyy-MM-dd")" /></label>
        <label>Jedem Absender höchstens
            <select name="Form.IntervalDays">
                @foreach (var days in new[] { 1, 3, 7, 14, 30 })
                {
                    <option value="@days" selected="@(Model.IntervalDays == days)">@(days == 1 ? "einmal pro Tag" : $"alle {days} Tage")</option>
                }
            </select>
        </label>
    </div>
    <label class="stack">Betreff (leer = „Automatische Antwort: “ + Betreff der Mail)
        <input name="Form.Subject" maxlength="200" value="@Model.Subject" placeholder="Ich bin bis … nicht erreichbar" />
    </label>
    <label class="stack">Text
        <textarea name="Form.Body" rows="8" maxlength="10000" placeholder="Vielen Dank für Ihre Nachricht. Ich bin bis … nicht im Büro …">@Model.Body</textarea>
    </label>
    <p class="small muted" style="margin-bottom: 0">Geantwortet wird nur auf Mails, in denen die Adresse unter An oder Cc steht – nicht auf
        Spam, Newsletter, Mailinglisten, Systemmeldungen oder andere automatische Antworten.</p>
</div>
